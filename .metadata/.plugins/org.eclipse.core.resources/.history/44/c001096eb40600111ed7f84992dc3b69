void strip_newline(char *s)
{
    size_t len = strlen(s);
    while (len > 0 &&
          (s[len-1] == '\n' || s[len-1] == '\r'))
    {
        s[--len] = '\0';
    }
}

FRESULT read_sd_state(const char *filename, FlightState_t *state, float *start_alt){
	FIL file;
	FRESULT res;

	char buf[20];

	// Open file for reading
	res = f_open(&file, filename, FA_READ);
	if (res != FR_OK)
		return res;

	// Read state line
	if (f_gets(buf, sizeof(buf), &file) == NULL) {
		f_close(&file);
		return FR_DISK_ERR;   // or FR_DISK_ERR if you prefer
	}


	// Read start alt line
	if (f_gets(buf, sizeof(buf), &file) == NULL) {
		f_close(&file);
		return FR_DISK_ERR;   // or FR_DISK_ERR if you prefer
	}

	strip_newline(state_buf);
	strip_newline(start_alt_buf);

	f_close(&file);
	return FR_OK;
}

uint8_t sd_file_exists(const char *filename)
{
    FILINFO fno;
    FRESULT res;

    res = f_stat(filename, &fno);

    if (res == FR_OK)
        return 1;   // file exists
    else
        return 0;   // file does not exist or error
}

