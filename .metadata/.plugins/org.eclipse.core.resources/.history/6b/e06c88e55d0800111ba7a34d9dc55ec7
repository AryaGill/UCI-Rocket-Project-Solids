#include "parachutes.h"

extern ADC_HandleTypeDef hadc1;

uint8_t read_ematch_adc(ADC_HandleTypeDef *hadc, uint32_t channel){
	ADC_ChannelConfTypeDef sConfig;
	sConfig.Channel = channel;
	HAL_ADC_ConfigChannel(hadc, &sConfig);

	HAL_ADC_Start(hadc);
	HAL_ADC_PollForConversion(hadc, HAL_MAX_DELAY);

	uint32_t adc = HAL_ADC_GetValue(hadc);

	HAL_ADC_Stop(hadc);

	if (adc < EMATCH_CONNECTED_THRESHOLD){
		return 0;
	}
	return 1;
}

void read_ematch_connections(Telemetry_t *telemetry){
	telemetry->main_p_ematch_connected = read_ematch_adc(&hadc1, MAIN_P_ADC_CHANNEL);
}

